---
/**
 * SPIKE — landing v2: opening, who I am, the map (peak), nothing gets lost.
 * Throwaway: lives on `spike/landing-v2` to see and feel the direction.
 * docs/v2/landing-v2-notes.md has the decisions; nothing here is final.
 */
import Base from "../layouts/Base.astro";
import {
  content,
  formatDateRange,
  formatDuration,
  formatMetric,
  formatMetricEnds,
  formatRoleTitle,
  formatSeniority,
  formatYearMonth,
  MESSAGES,
  pdfFilename,
} from "@content";
import { RING_PATH, N_PATH, N_WEIGHT, BRAND_VIEWBOX } from "../lib/brand";
import { LOCALE_PATHS } from "../lib/anchors";
import Logo from "../components/Logo.astro";
import SkillIcon from "../components/v2/SkillIcon.astro";

import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/800.css";
import "../styles/tokens.css";
import "../styles/v2.css";

const locale = "es";
const view = await content.getView("portfolio", locale);
const { identity } = view;
const m = MESSAGES[locale];
const paths = LOCALE_PATHS[locale];
const years = formatSeniority(view.yearsOfExperience, locale);

const achievements = view.experience.flatMap((r) => r.achievements);
const byId = (id: string) => {
  const a = achievements.find((x) => x.id === id);
  if (!a) throw new Error(`spike: achievement ${id} not in the portfolio view`);
  return a;
};

// --- 1. Opening -------------------------------------------------------------
// Hook: provisional, the author's wording (2026-10-26). To be decided on screen.
const hook =
  "Construyo experiencias modernas y de vanguardia sacando el máximo potencial a las herramientas de IA.";
const nameParts = identity.fullName.split(" ");
const displayName = [nameParts[0], nameParts[2]];

// --- 2. Who I am -------------------------------------------------------------
// The manifesto is split into words so the scroll can light them one by one.
// "Foco en el frontend" is the author's own positioning (2026-10-26).
const manifesto = `Soy ${identity.preferredName}. Desarrollador full stack con el foco puesto en el frontend: ${years} construyendo productos web completos, de la interfaz al deploy.`;
const manifestoWords = manifesto.split(" ");
const sk = view.skills;
// Astro: the author's ask (2026-10-28), NOT in the dataset yet — this very
// site is built with it. SPIKE-only; the real build adds it as a Skill in
// content.es.json (+ en, i18n:lock, og:local, and a check that the PDF still
// fits in 2 pages), and this line goes.
const astro = { id: "astro", name: "Astro" };
const frontend = sk.frontend.flatMap((s) => (s.id === "nextjs" ? [s, astro] : [s]));
const plates = [
  { id: "front", label: "Interfaz", note: "Donde más profundo voy", skills: [...sk.language, ...frontend, ...sk.data].slice(0, 11) },
  { id: "back", label: "Servidor y CMS", note: "Lo que el problema pida", skills: [...sk.backend, ...sk.cms].slice(0, 6) },
  { id: "ship", label: "Entrega", note: "Del repo a producción", skills: [...sk.infra, ...sk.tooling, ...sk.testing, ...sk.practice].slice(0, 8) },
];
const career = [...view.experience]
  .sort((a, b) => a.start.localeCompare(b.start))
  .map((r) => ({ company: r.company, title: r.displayTitle ?? r.title, start: formatYearMonth(r.start, locale).slice(-4) }));

// --- 3. The map --------------------------------------------------------------
const map = byId("dinkum-mapbox");
const fix = byId("dinkum-mapbox-fix");
const index = byId("dinkum-mapbox-index");
// The counter runs up to the dataset's own figure; the "~" of the estimate is
// shown by `formatMetric` in the label underneath, never typed here (rule 4).
const counterTarget = Number((map.metric?.delta ?? "0").replace(/\D/g, ""));
const beats = [
  { kicker: "El encargo", title: "El mapa del informe de RPPL.", body: map.text.short },
  {
    kicker: "La escala",
    title: map.metric ? formatMetric(map.metric, locale) : "",
    body: "Cada polígono es un distrito escolar con sus indicadores.",
    counter: true,
  },
  { kicker: "Lo que se rompía", title: "Pintura sucia y un hover que no llegaba.", body: fix.text.short },
  { kicker: "La decisión", title: "Un índice, fuera del hilo de la interfaz.", body: index.text.short },
  {
    kicker: "El resultado",
    title: index.metric ? formatMetric(index.metric, locale) : "",
    body: "La interfaz no se bloquea mientras indexa un JSON de 7 MB.",
    // Each bar carries its own end of the metric, "~" included (rule 4).
    bars: index.metric ? formatMetricEnds(index.metric) : null,
  },
];

// --- 4. Nothing gets lost ------------------------------------------------------
const seatPlugin = byId("dinkum-wp");
const asyncPile = byId("dinkum-woo-sync");
const seatBeats = [
  { kicker: "El encargo", title: "Un mapa de asientos dentro de WooCommerce.", body: seatPlugin.text.short },
  {
    kicker: "Lo que se rompía",
    title: "Dos clicks, dos verdades.",
    body: "Dos clicks seguidos disparaban mutaciones concurrentes al Store API: el nonce rotaba y el mapa se desfasaba del carrito.",
  },
  { kicker: "La decisión", title: "AsyncPile: una operación a la vez.", body: asyncPile.text.short },
  {
    kicker: "El resultado",
    title: "Los mismos asientos en todas partes.",
    body: "Pasé de cart_key a session_owner para que recarga, minicart y checkout vean los mismos asientos.",
  },
];

// An illustrative hall: rows on an arc facing the stage. Deterministic, so the
// "sold" pattern is the same on every build.
const ROWS = "ABCDEFGHIJ";
const PICK_ROW = 5;
const seats: { x: number; y: number; id: string; sold: boolean; pick: number | null }[] = [];
for (let i = 0; i < ROWS.length; i++) {
  const r = 150 + i * 27;
  const count = Math.floor((r * 1.25) / 21);
  const mid = Math.floor(count / 2);
  for (let j = 0; j < count; j++) {
    const t = (j / (count - 1) - 0.5) * 1.25;
    const id = `${ROWS[i]}${j + 1}`;
    const pick = i === PICK_ROW && j >= mid - 1 && j < mid + 3 ? j - (mid - 1) : null;
    const sold = pick === null && ((i * 7 + j * 13) % 9 < 2 || (i > 6 && (i + j) % 5 === 0));
    seats.push({ x: 400 + r * Math.sin(t), y: -70 + r * Math.cos(t), id, sold, pick });
  }
}
const picked = seats.filter((s) => s.pick !== null).sort((a, b) => a.pick! - b.pick!);

// --- 5. DeltaDictum ---------------------------------------------------------------
// NOT in the dataset yet. Copied from the DeltaDictum repository
// (C:\dev\supermem): README, CHANGELOG and its site's landing. The benchmark
// is NOT public, so nothing from it appears here. Before the real build this
// becomes a Project in content.es.json.
const dd = {
  repo: "https://github.com/CribbNicolas/deltadictum",
  docs: "https://cribbnicolas.github.io/deltadictum/",
  version: "1.1.0",
  prompt: "add a test for the store's close() method",
  checks: ["Sin cuenta, sin llamadas a modelos", "Las memorias son archivos en tu repo", "En silencio cuando nada aplica"],
};
// The memory the page "delivers" to the reader on the way in, in DD's own
// format ([DECISION] is one of DD's three kinds). PROVISIONAL copy, for the
// author to confirm: it carries the three things this chapter has to land —
// my own product, built from how I work, about how agents actually work.
const ddHook =
  "[DECISION] Lo que sigue no es un encargo: es un producto mío. Lo construí trabajando con agentes de código, para darles lo que el código no dice, justo antes de cada acción.";

// --- 6. The journey ------------------------------------------------------------
// Adaptability as a dated trail, not an adjective. Each stage lists the skills
// whose FIRST recorded use is an achievement of that stage — derived from
// `skillIds`, so the toolbox only grows with work that is in the dataset.
const skillName = new Map(Object.values(view.skills).flat().map((s) => [s.id, s.name]));
const seen = new Set<string>();
const journey = [...view.experience]
  .sort((a, b) => a.start.localeCompare(b.start))
  .map((r) => {
    const fresh = [...new Set(r.achievements.flatMap((a) => a.skillIds))].filter((id) => !seen.has(id));
    fresh.forEach((id) => seen.add(id));
    return {
      company: r.company,
      title: formatRoleTitle(r, locale),
      range: formatDateRange(r.start, r.end, locale),
      duration: formatDuration(r.durationMonths, locale),
      year: r.start.slice(0, 4),
      context: r.context.short,
      wins: r.achievements.slice(0, 2).map((a) => a.text.short),
      fresh: fresh.map((id) => ({ id, name: skillName.get(id) ?? id })),
    };
  });
// --- 7. How I work ---------------------------------------------------------------
// The stance from `summary.long` ("Uso Claude y Cursor todos los días. Lo que
// entra al repo lo reviso yo."), and its proof: what this repository enforces.
const principles = [
  {
    title: "IA todos los días, con la revisión de mi lado.",
    body: "Claude y Cursor son parte del flujo. Qué entra al repo no se delega: lo deciden la revisión y los checks.",
  },
  {
    title: "Ningún número inventado.",
    body: "Las métricas distinguen medido de estimado — el “~” no se escribe a mano, lo pone el código. Lo que no sé queda como TODO, no como un número lindo.",
  },
  {
    title: "El CV que lee un ATS, intacto.",
    body: "La página que se imprime como PDF es una columna y no carga JavaScript. Un check lo vigila en cada push, porque es lo que llega a quien contrata.",
  },
];
// The CI of THIS repo, in the order content-validation.yml runs it. Spike:
// typed here; the real build should read the workflow file instead.
const gates = [
  { cmd: "test:workflows", what: "el CI se valida a sí mismo" },
  { cmd: "typecheck", what: "tipos de todo el repo" },
  { cmd: "validate", what: "el dataset cumple el contrato" },
  { cmd: "test", what: "visibilidad, estimados con “~”, invariantes" },
  { cmd: "test:format", what: "datos en forma canónica" },
  { cmd: "test:i18n", what: "el inglés al día con el español" },
  { cmd: "test:editor", what: "el editor de contenido, en Chromium" },
  { cmd: "build", what: "el sitio estático" },
  { cmd: "pdf:local", what: "imprime el CV" },
  { cmd: "test:pdf", what: "el PDF que se imprime" },
  { cmd: "test:js", what: "/cv sin JavaScript" },
  { cmd: "test:bundle", what: "presupuesto de bytes" },
  { cmd: "test:landing", what: "/cv aislado y sin indexar" },
  { cmd: "test:endpoints", what: "/cv.json y /llms.txt completos" },
  { cmd: "test:og", what: "la imagen para compartir, al día" },
];
const LEVEL: Record<string, string> = { native: "nativo" };
const languagesLine = view.languages.map((l) => `${l.name} ${LEVEL[l.level] ?? l.level}`).join(" · ");

// --- 8. Close ---------------------------------------------------------------------
// The closing line is the dataset's own (last sentence of `summary.long`).
const closingLine = (identity.summary.long ?? identity.summary.short).trim().split("\n").at(-1)!.split(". ").at(-1)!;
// Both PDFs, each named from ITS dataset's `updatedAt` (as HomeDocument does):
// using one date for both would mislabel whichever is not this page's own.
const [datasetEs, datasetEn] = await Promise.all([content.getDataset("es"), content.getDataset("en")]);
const cvLinks = [
  { side: "es", short: "ESP", lang: "es", href: LOCALE_PATHS.es.pdf, file: pdfFilename("es", datasetEs.updatedAt), label: "Descargar el CV en español (PDF)" },
  { side: "en", short: "EN", lang: "en", href: LOCALE_PATHS.en.pdf, file: pdfFilename("en", datasetEn.updatedAt), label: "Descargar el CV en inglés (PDF)" },
];

---

<Base locale={locale} title={`${identity.fullName} — v2 (spike)`} description={identity.summary.short}>
  <script is:inline slot="head">
    document.documentElement.classList.add("js");
  </script>

  <div class="loader" data-loader aria-hidden="true">
    <svg class="loader__mark" viewBox={BRAND_VIEWBOX} width="120" height="120">
      <path data-ring-fill d={RING_PATH} fill="var(--accent)" />
      <path data-ring-outline d={RING_PATH} fill="none" stroke="var(--accent)" stroke-width="0.6" />
      <path
        data-ring-n
        d={N_PATH}
        fill="none"
        stroke="var(--ink)"
        stroke-width={N_WEIGHT}
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <p class="loader__pct mono" data-loader-pct>0%</p>
  </div>

  <nav class="dock" aria-label="Accesos">
    <a class="dock__logo" href="#top"><Logo size={22} /></a>
    <a class="dock__cv" href={paths.pdf} download data-cv-open>{m.downloadCv}</a>
    <a class="dock__lang" href={LOCALE_PATHS.en.home} hreflang="en">EN</a>
  </nav>

  {/*
    Where the seats chapter switches off, like an old screen: bars close in
    to a line, the line to a dot. On that black the page intercepts the
    reader the way DD intercepts an agent (seats.ts). Outside <main> on
    purpose: a pinned ancestor would trap a fixed layer.
  */}
  <div class="crt" data-crt aria-hidden="true">
    <i class="crt__bar crt__bar--top"></i><i class="crt__bar crt__bar--bottom"></i>
    <i class="crt__bar crt__bar--left"></i><i class="crt__bar crt__bar--right"></i>
    <i class="crt__line" data-crt-line></i>
    <i class="crt__dot" data-crt-dot></i>
    <div class="ddx" data-ddx>
      <p class="ddx__cmd" data-ddx-cmd><span data-ddx-type>Scroll(DeltaDictum)</span><span class="ddx__caret" data-ddx-caret></span></p>
      <p class="ddx__l gray" data-ddx-l>⎿  PreToolUse:Scroll hook additional context:</p>
      <p class="ddx__l gray nest" data-ddx-l>DD - project knowledge (este portfolio):</p>
      <p class="ddx__mem nest" data-ddx-mem>{ddHook}</p>
      <p class="ddx__go mono" data-ddx-go>Seguí bajando <span aria-hidden="true">↓</span></p>
    </div>
  </div>

  {/*
    "Descargar CV" from anywhere: the close's C and its two halves, pulled up
    into the middle over a dark scrim (cvmodal.ts copies them in here).
  */}
  <div class="cvmodal" data-cvmodal hidden>
    <div class="cvmodal__scrim" data-cvmodal-scrim></div>
    <div class="cvmodal__body" role="dialog" aria-modal="true" aria-label={m.downloadCv}>
      <p class="mono cvmodal__kicker" data-cvmodal-kicker>{m.downloadCv} · elegí el idioma</p>
      <div class="cvmodal__slot" data-cvmodal-slot></div>
    </div>
    <button class="cvmodal__x" type="button" data-cvmodal-close aria-label="Cerrar">×</button>
  </div>

  <main id="top">
    {/* --- 1 + 2. Opening and who I am: ONE pinned stage ------------------ */}
    {/*
      The C grows over the opening until the whole screen is its color, and
      "Quién soy" is revealed ON that color. Both layers live in one stage so
      the hand-off is a single timeline, not two sections meeting at a seam.
    */}
    <section class="intro" data-intro aria-label="Apertura y quién soy">
      <div class="intro__stage" data-intro-stage>
        <div class="hero" data-hero>
          <div class="hero__copy">
            <p class="hero__meta mono" data-hero-fade>{identity.searchTitle} · {identity.brandTitle}</p>
            <h1 class="hero__name" data-hero-name>
              {displayName.map((part) => <span class="hero__line">{part}</span>)}
            </h1>
            <p class="hero__hook" data-hero-fade>{hook}</p>
            <p class="hero__facts mono" data-hero-fade>
              {years} · {identity.location.city}, {identity.location.country} · {identity.location.timezone}
            </p>
            <div class="hero__actions" data-hero-fade>
              <a class="btn btn--solid" href={paths.pdf} download data-cv-open>{m.downloadCv}</a>
              <a class="btn" href={`mailto:${identity.contact.email}`}>Escribime</a>
            </div>
          </div>

          {/*
            The guided version is opt-in by scrolling; the simple one is one
            click away. Which cue shows is decided by the INPUT, not the
            width (v2.css): a touch screen gets the finger, a mouse the wheel.
            SPIKE: the simple version is the current landing until the real
            build gives it its own route — /cv cannot be it, it takes no
            incoming links (single-landing.check.ts).
          */}
          <div class="hero__choice" data-hero-fade>
            <p class="hero__cue">
              <span class="cue cue--wheel" aria-hidden="true"><i></i></span>
              <svg class="cue cue--swipe" viewBox="0 0 24 24" aria-hidden="true">
                {/* Pointing hand, after Lucide's "pointer" (ISC). */}
                <g>
                  <path d="M22 14a8 8 0 0 1-8 8" />
                  <path d="M18 11v-1a2 2 0 0 0-2-2a2 2 0 0 0-2 2" />
                  <path d="M14 10V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1" />
                  <path d="M10 9.5V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v10" />
                  <path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
                </g>
              </svg>
              <span>Bajá para ver el recorrido guiado</span>
            </p>
            <span class="hero__alt">
              <span class="hero__or mono" aria-hidden="true">o</span>
              <a class="hero__simple" href={paths.home}>Ver la versión simple <span aria-hidden="true">→</span></a>
            </span>
          </div>
        </div>

        <div class="hero__ringwrap" data-ring-wrap aria-hidden="true">
          <svg class="hero__ring" data-hero-ring viewBox={BRAND_VIEWBOX}>
            <path d={RING_PATH} fill="var(--accent)" />
          </svg>
        </div>

        <div class="about" data-about>
          <div class="about__copy">
            <p class="mono about__kicker">Quién soy</p>
            <p class="about__manifesto" data-manifesto>
              {manifestoWords.map((w) => <span class="w">{w} </span>)}
            </p>
            <p class="about__summary" data-about-summary>{identity.summary.short}</p>
          </div>

          <div class="stack" data-stack aria-hidden="true">
            <div class="stack__iso" data-stack-iso>
              {
                plates.map((p, i) => (
                  <div class={`plate plate--${p.id}`} data-plate={i}>
                    <div class="plate__face">
                      <p class="plate__label">
                        <span class="mono">{String(i + 1).padStart(2, "0")}</span> {p.label}
                        <em>{p.note}</em>
                      </p>
                      <ul class="plate__chips">
                        {p.skills.map((s) => (
                          <li>
                            <SkillIcon id={s.id} />
                            {s.name}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <ol class="career" data-career>
            {
              career.map((c) => (
                <li class="career__stop">
                  <span class="mono">{c.start}</span>
                  <strong>{c.company}</strong>
                  <small>{c.title}</small>
                </li>
              ))
            }
            <li class="career__line" aria-hidden="true"><i data-career-line></i></li>
          </ol>
        </div>
      </div>
    </section>

    {/* --- 3. The map, the peak -------------------------------------------- */}
    <section class="peak chapter" data-peak aria-label="Primera prueba: el mapa de RPPL">
      <div class="peak__stage chapter__stage" data-peak-stage>
        <div class="peak__world" data-peak-world>
          <div class="peak__tilt" data-peak-tilt>
            <canvas class="peak__canvas" data-peak-canvas aria-hidden="true"></canvas>
          </div>
        </div>
        {/* The C from "Quién soy", still covering the screen: it shrinks away to reveal the map. */}
        <div class="peak__ringwrap" data-peak-ringwrap aria-hidden="true">
          <svg class="peak__ring" data-peak-ring viewBox={BRAND_VIEWBOX}>
            <path d={RING_PATH} fill="var(--accent)" />
          </svg>
        </div>

        <ol class="beats">
          {
            beats.map((b, i) => (
              <li class="beat" data-beat={i}>
                <p class="beat__kicker mono">
                  <span>{String(i + 1).padStart(2, "0")}</span> {b.kicker}
                </p>
                <h2 class="beat__title">
                  {b.counter ? <span data-counter data-target={counterTarget}>0</span> : b.title}
                </h2>
                {b.counter && <p class="beat__label mono">{b.title}</p>}
                <p class="beat__body">{b.body}</p>
                {b.bars && (
                  <div class="bars" aria-hidden="true">
                    <div class="bars__row">
                      <span class="mono">antes</span>
                      <span class="bars__track"><i data-bar-before></i><b class="mono" data-bar-val>{b.bars.before}</b></span>
                    </div>
                    <div class="bars__row">
                      <span class="mono">después</span>
                      <span class="bars__track"><i data-bar-after></i><b class="mono" data-bar-val>{b.bars.after}</b></span>
                    </div>
                  </div>
                )}
              </li>
            ))
          }
        </ol>

        <div class="rail" aria-hidden="true">
          {beats.map((_, i) => <i data-rail={i}></i>)}
        </div>
        <p class="chapter__note mono">Geometría ilustrativa · los números son reales</p>
      </div>
    </section>

    {/* --- 4. Nothing gets lost -------------------------------------------- */}
    <section class="seats chapter" data-seats aria-label="Segunda prueba: el mapa de asientos">
      <div class="chapter__stage" data-seats-stage>
        <div class="seats__visual">
          <div class="hall3d" data-hall3d>
          <svg class="hall" viewBox="0 0 800 340" aria-hidden="true" data-hall>
            <rect class="hall__stage" x="300" y="6" width="200" height="22" rx="4" />
            <text class="hall__stage-label" x="400" y="21">ESCENARIO</text>
            {
              seats.map((s) => (
                <circle
                  class:list={["seat", { "seat--sold": s.sold }]}
                  cx={s.x.toFixed(1)}
                  cy={s.y.toFixed(1)}
                  r="7.2"
                  data-pick={s.pick ?? undefined}
                />
              ))
            }
          </svg>
          </div>

          <div class="flow">
            <div class="lane" data-lane>
              <span class="lane__label mono" data-pile-label>AsyncPile</span>
              {picked.map((s, i) => <span class="token mono" data-token={i}>+{s.id}</span>)}
              <span class="token token--lost mono" data-token-lost>nonce ✕</span>
            </div>
            <div class="cart" data-cart>
              <p class="mono">Carrito</p>
              <ul>
                {picked.map((s, i) => <li data-cart-item={i}>Fila {s.id[0]} · {s.id.slice(1)}</li>)}
              </ul>
            </div>
          </div>

          <p class="sync mono" data-sync>
            mapa <b data-sync-map>0</b> · carrito <b data-sync-cart>0</b>
          </p>

          <div class="surfaces" data-surfaces>
            {
              ["Recarga", "Minicart", "Checkout"].map((label) => (
                <div class="surface">
                  <p class="mono">{label}</p>
                  <p>{picked.map((s) => s.id).join(" · ")}</p>
                </div>
              ))
            }
          </div>
        </div>

        <ol class="beats">
          {
            seatBeats.map((b, i) => (
              <li class="beat" data-seat-beat={i}>
                <p class="beat__kicker mono">
                  <span>{String(i + 1).padStart(2, "0")}</span> {b.kicker}
                </p>
                <h2 class="beat__title">{b.title}</h2>
                <p class="beat__body">{b.body}</p>
              </li>
            ))
          }
        </ol>

        <div class="rail" aria-hidden="true">
          {seatBeats.map((_, i) => <i data-seat-rail={i}></i>)}
        </div>
        <p class="chapter__note mono">Sala ilustrativa · el problema y la solución son reales</p>
      </div>
    </section>

    {/* --- 5. DeltaDictum ------------------------------------------------------ */}
    {/*
      Follows what DD's own site shows (cribbnicolas.github.io/deltadictum):
      the claim with a live session, how it works in three steps, how to
      install. The benchmark is NOT shown: it is not public.
    */}
    {/* --- 5. DeltaDictum: the second hook ------------------------------- */}
    {/*
      It lands on the black the seats chapter switched off into (the .crt
      layer, outside <main>), so it opens on nothing: then the name, the race
      with and without DD, and the same session annotated. The terminals are
      in English on purpose: they ARE Claude Code sessions.
    */}
    <section class="dd chapter" data-dd aria-label="Proyecto propio: DeltaDictum">
      <div class="chapter__stage dd__stage" data-dd-stage>
        <div class="ddm" data-ddm>
          <p class="mono ddm__kicker" data-ddm-kicker><span>Proyecto propio</span> · 2026 · v{dd.version}</p>
          <h2 class="ddm__name" data-ddm-name>DeltaDictum.</h2>
          <p class="ddm__claim" data-ddm-claim>
            {"Lo que tu código no dice,".split(" ").map((w) => <span class="w">{w} </span>)}
            <em>{"dicho en el momento justo.".split(" ").map((w) => <span class="w">{w} </span>)}</em>
          </p>
          <p class="ddm__lede" data-ddm-lede>
            Guarda las decisiones, las trampas y los pasos no escritos de un proyecto como memorias en git, y le entrega
            cada una al agente de código justo antes de la acción a la que aplica.
          </p>
        </div>

        <div class="ddrace" data-ddrace>
          <p class="ddrace__ask mono" data-ddrace-ask>
            El mismo pedido, el mismo agente · <span>ilustrativo</span>
          </p>
          {
            (["off", "on"] as const).map((side) => (
              <figure class={`ddterm ddterm--${side}`} data-race={side}>
                <figcaption class="ddterm__cap">
                  {side === "off" ? "Sin DD: el agente no conoce la trampa" : "Con DD: la memoria llega antes de editar"}
                </figcaption>
                <div class="ddterm__chrome" aria-hidden="true">
                  <i></i><i></i><i></i><span>~/my-project — claude{side === "on" ? " · DD" : ""}</span>
                </div>
                <div class="ddterm__screen">
                  <p class="tl prompt" data-l="prompt">&gt; <span data-type>{dd.prompt}</span></p>
                  <p class="tl gap" data-l="answer"><span class="white">⏺</span> I'll add the test in tests/store.test.js.</p>
                  {side === "on" && (
                    <div class="tl" data-l="hook">
                      <p class="gray" data-note-anchor="2">⎿  PreToolUse:Edit hook additional context:</p>
                      <p class="gray nest">DD - project knowledge (tests/store.test.js):</p>
                      <p class="nest memory" data-note-anchor="1">[TRAP] Close stores in t.after - a failing assertion otherwise leaves the handle open and node --test never ends.</p>
                    </div>
                  )}
                  <p class="tl gap" data-l="update"><span class="green">⏺</span> <strong>Update</strong>(tests/store.test.js)</p>
                  <div class="tl" data-l="diff">
                    <p class="nest add">+  const store = openStore(dir);</p>
                    {side === "on" ? (
                      <p class="nest add">+  t.after(() =&gt; store.close());</p>
                    ) : (
                      <>
                        <p class="nest add">+  assert.equal(store.get("k"), "v");</p>
                        <p class="nest add">+  store.close();</p>
                      </>
                    )}
                  </div>
                  <p class="tl gap" data-l="run"><span class="green">⏺</span> <strong>Bash</strong>(node --test)</p>
                  {side === "off" ? (
                    <p class="tl nest bad" data-l="result">⎿  ✗ 1 failing · close() never ran · still running…</p>
                  ) : (
                    <p class="tl nest ok" data-l="result" data-note-anchor="3">⎿  ✓ node --test exited · the store closed in t.after</p>
                  )}
                </div>
                {/* The outcome, big enough to read from across the room. */}
                {side === "off" ? (
                  <p class="tl ddterm__verdict bad" data-l="verdict">
                    <span class="spin" data-spin>⠋</span> Colgado · <span data-clock>0:00</span>
                  </p>
                ) : (
                  <p class="tl ddterm__verdict ok" data-l="verdict">✓ Terminó</p>
                )}
              </figure>
            ))
          }
          <ol class="ddnotes" aria-label="Cómo funciona">
            <li class="ddnote" data-note="1">
              <span class="ddnote__n mono">1</span>
              <h3>Guardada con evidencia</h3>
              <p>
                Se la pedís al agente, o DD la propone después de un arreglo. DD calcula el hash del archivo que la memoria
                cita: con evidencia verificada se activa al instante; si no, espera una revisión humana.
              </p>
            </li>
            <li class="ddnote" data-note="2">
              <span class="ddnote__n mono">2</span>
              <h3>Reglas, no búsqueda</h3>
              <p>
                Antes de cada lectura, edición o comando, un hook compara la acción con los disparadores de las memorias.
                Una regla aplica o no aplica. Local: sin cuenta, sin llamadas a modelos, sin dependencias.
              </p>
            </li>
            <li class="ddnote" data-note="3">
              <span class="ddnote__n mono">3</span>
              <h3>A tiempo, y compartida</h3>
              <p>
                Llega con la acción a la que aplica, una vez por sesión. Las memorias son archivos JSON en el repo: quien hace
                pull recibe las mismas, y las nuevas se revisan como código.
              </p>
            </li>
          </ol>
          <svg class="ddlinks" data-ddlinks aria-hidden="true"></svg>
        </div>

        <p class="ddgo mono" data-dd-go>Seguí bajando <span aria-hidden="true">↓</span></p>
        <div class="rail" aria-hidden="true">
          {[0, 1].map((i) => <i data-dd-rail={i}></i>)}
        </div>
      </div>

      <div class="ddcta">
        <p class="ddcta__line" data-dd-reveal>
          Un producto mío, hecho para la forma en que trabajo con agentes de código.
        </p>
        <p class="dd__pill mono" data-dd-reveal>
          <span class="live" aria-hidden="true"></span>Claude Code, Codex y OpenCode · Cursor y Grok Build en preview
        </p>
        <ul class="dd__checks" data-dd-reveal>
          {
            dd.checks.map((c) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
                {c}
              </li>
            ))
          }
        </ul>
        <p class="dd__links" data-dd-reveal>
          <a class="btn btn--solid" href={dd.repo}>Ver en GitHub</a>
          <a class="btn" href={dd.docs}>Documentación</a>
        </p>
        <ul class="dd__facts" data-dd-reveal>
          <li><b>v{dd.version}</b><span>publicado en npm</span></li>
          <li><b>3 + 2</b><span>harnesses soportados y en preview</span></li>
          <li><b>10/09 → 22/10</b><span>del primer commit al 1.0, en 2026</span></li>
          <li><b>PolyForm Shield</b><span>código disponible, uso libre</span></li>
        </ul>
      </div>
    </section>

    {/* --- 6. The journey ------------------------------------------------- */}
    <section class="journey" data-journey aria-label="Recorrido">
      <header class="journey__head">
        <p class="mono journey__kicker">Recorrido</p>
        <h2>{years}, {journey.length} etapas.</h2>
        <p class="journey__lede">
          A la derecha, el stack crece con cada etapa: cada herramienta aparece en el año del primer logro que la usa.
        </p>
      </header>

      <div class="journey__body">
        <ol class="journey__stages">
          <li class="journey__line" aria-hidden="true"><i data-journey-line></i></li>
          {
            journey.map((r, i) => (
              <li class="stage" data-stage={i} data-year={r.year}>
                <span class="stage__dot" aria-hidden="true"></span>
                <p class="mono stage__when">{r.range} · {r.duration}</p>
                <h3 class="stage__company">{r.company}</h3>
                <p class="stage__title">{r.title}</p>
                <p class="stage__context">{r.context}</p>
                <ul class="stage__wins">
                  {r.wins.map((w) => (
                    <li>{w}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>

        <aside class="toolbox" aria-hidden="true">
          <div class="toolbox__sticky">
            <p class="mono">Stack en</p>
            <p class="toolbox__year" data-toolbox-year>{journey[0]?.year}</p>
            <p class="mono"><span data-toolbox-count>0</span> herramientas</p>
            <ul class="toolbox__chips">
              {
                journey.flatMap((r, i) =>
                  r.fresh.map((s) => (
                    <li data-chip-stage={i}>
                      <SkillIcon id={s.id} />
                      {s.name}
                    </li>
                  )),
                )
              }
            </ul>
          </div>
        </aside>
      </div>
    </section>

    {/* --- 7. How I work ---------------------------------------------------- */}
    {/*
      The calm chapter: little motion, a lot of proof. The proof is THIS site:
      the panel lists the CI steps that really run on every push
      (.github/workflows/content-validation.yml), and they tick as you read.
      Limits come last, after the proof (the pratfall effect only helps
      someone already seen as competent).
    */}
    <section class="work" data-work aria-label="Cómo trabajo">
      <div class="work__body">
        <div class="work__principles">
          <header class="work__head">
            <p class="mono work__kicker">Cómo trabajo</p>
            <h2>La IA escribe rápido. Lo que entra al repo lo decido yo.</h2>
          </header>
          {
            principles.map((p, i) => (
              <article class="principle" data-principle={i}>
                <p class="mono principle__num">{String(i + 1).padStart(2, "0")}</p>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </article>
            ))
          }
          <article class="principle principle--limits" data-principle={principles.length}>
            <p class="mono principle__num">Límites, dichos de entrada</p>
            <h3>{languagesLine}.</h3>
            <p>
              El inglés está en A2: lo digo acá para que no lo descubras en una entrevista. Trabajo remoto desde{" "}
              {identity.location.city}, {identity.location.timezone}.
            </p>
          </article>
        </div>

        <aside class="pipeline" aria-label="Los checks que corre cada push de este sitio">
          <div class="pipeline__sticky">
            <p class="mono pipeline__title">Cada push de este sitio pasa por <b class="pipeline__count"><span data-gate-count>0</span>/{gates.length}</b></p>
            <ol class="pipeline__list">
              {
                gates.map((g) => (
                  <li class="gate" data-gate>
                    <span class="gate__mark" aria-hidden="true"></span>
                    <code>{g.cmd}</code>
                    <span>{g.what}</span>
                  </li>
                ))
              }
            </ol>
            <p class="pipeline__deploy mono" data-deploy><span aria-hidden="true">●</span> listo para publicar</p>
          </div>
        </aside>
      </div>
    </section>

    {/* --- 8. Close --------------------------------------------------------- */}
    {/*
      Peak-end: the ending is half of what is remembered. The C that opened the
      page comes back, turns once, and its hole BECOMES the download button,
      split in two halves: the CV in Spanish and in English. Not pinned: the C
      enters while the section rises, so there is never an empty screen.
    */}
    <section class="close" data-close aria-label="Cierre: descargar el CV y contacto">
      <div class="close__stage">
        <div class="close__ringwrap">
          <svg class="close__ring" data-close-ring viewBox={BRAND_VIEWBOX} aria-hidden="true">
            <path d={RING_PATH} fill="var(--accent)" />
          </svg>
          <div class="close__cv" data-close-cv>
            {
              cvLinks.map((cv) => (
                <a class:list={["close__half", `close__half--${cv.side}`]} href={cv.href} download={cv.file} hreflang={cv.lang} aria-label={cv.label}>
                  <span class="close__half-lang">{cv.short}</span>
                  <span class="close__half-file mono">PDF</span>
                </a>
              ))
            }
          </div>
        </div>

        <div class="close__copy" data-close-copy>
          <p class="mono close__kicker">{m.downloadCv} · español o inglés</p>
          <p class="close__line">{closingLine}</p>
          <ul class="close__contact">
            <li><a href={`mailto:${identity.contact.email}`}>{identity.contact.email}</a></li>
            {identity.links.map((l) => (
              <li><a href={l.url}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <footer class="foot">
        <span>{identity.fullName} · {identity.location.city}, {identity.location.country}</span>
        <span class="foot__agents">
          Para agentes: <a href={paths.llms}>llms.txt</a> · <a href={paths.json}>cv.json</a>
        </span>
      </footer>
    </section>
  </main>

  <script>
    import { start } from "../scripts/v2/main";
    start();
  </script>
</Base>
