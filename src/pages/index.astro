---
/**
 * La home: identidad + el mapa de conocimiento.
 *
 * El mapa es la vista que cumple la promesa del CONTRATO §3 — los `Achievement`
 * viven sueltos para poder cruzarlos, y ninguna otra superficie los cruza.
 * Vivió en `/lab` mientras la home era un placeholder; ahora es la portada.
 * Decisión fechada en `docs/00-indice.md` y estructura en `docs/04` §1.
 *
 * Es la ÚNICA página del sitio que envía JavaScript, y por eso está en
 * `PAGINAS_CON_JS` de `scripts/no-client-js.check.ts`. `/cv` sigue en cero: de
 * ahí sale el PDF, y un script que se cuele cambia el render en silencio.
 *
 * TODO el cálculo del grafo corre acá, en build. Nada de esa derivación viaja
 * al browser: el cliente recibe coordenadas ya resueltas.
 */
import Base from "../layouts/Base.astro";
import { content, formatSeniority, formatDateRange, formatYearMonth, buildKnowledgeGraph, layoutGraph } from "@content";
import { buildPersonJsonLd } from "../lib/jsonld";
import { buildSvgMapa } from "../lib/graph-svg";
import { buildHoverCss, ID_ITEM } from "../lib/lab-hover-css";
import GraphSvg from "../components/lab/GraphSvg.astro";
import ListaProyectos from "../components/proyectos/ListaProyectos.astro";
import Section from "../components/cv/Section.astro";
import RoleBlock from "../components/cv/RoleBlock.astro";
import SkillList from "../components/cv/SkillList.astro";

import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/800.css";
import "../styles/tokens.css";
import "../styles/home.css";
import "../styles/cv.css";
import "../styles/proyectos.css";
import "../styles/lab.css";

const view = await content.getView("portfolio", "es");
// Regla 7: `cv-ats` recorta por prioridad (cutoff 3) y topea en 5 logros por
// rol; `portfolio` no recorta nada. La sección de abajo tiene que mostrar
// EXACTAMENTE lo que sale impreso, porque el botón de descarga promete "el CV".
const viewCv = await content.getView("cv-ats", "es");
const { identity } = view;
const jsonLd = buildPersonJsonLd(view, new URL(Astro.site!));

/**
 * El token del beacon de Cloudflare Web Analytics.
 *
 * NO es secreto: viaja en el HTML de cada visita, igual que el ID de Clarity.
 * Se lee de una variable igual, por lo mismo — para rotarlo o apagar la
 * medición sin tocar código, y porque así el token no vive en un repo público
 * donde queda en el historial aunque después se cambie.
 *
 * Si no está definida, el `<script>` no se renderiza: en dev y en cualquier
 * build sin configurar, la analítica no existe.
 */
const beaconCloudflare: string | undefined = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

const grafo = buildKnowledgeGraph(view);
const posicionado = layoutGraph(grafo);
const mapa = buildSvgMapa(posicionado);
const hoverCss = buildHoverCss(posicionado);

// Lo que el runtime 3D necesita. Coordenadas ya redondeadas por `layoutGraph`.
// Claves de una letra: esto viaja en el HTML de cada visita, y con 37 nodos los
// nombres largos de propiedad costarían más que los datos.
const datosGrafo = JSON.stringify({
  nodes: posicionado.nodes.map((n) => ({
    i: n.id, k: n.kind, x: n.x, y: n.y, z: n.z, d: n.degree,
    r: Math.round(n.escalaRadio * 100) / 100,
    n: n.label, t: n.detail, ...(n.categoria ? { c: n.categoria } : {}),
  })),
  edges: posicionado.edges.map((e) => ({ s: e.source, t: e.target, a: e.kind === "afinidad", w: e.weight })),
  radio: posicionado.radioEncuadre,
});

// La lista del DOM: es a la vez el contenido accesible y el lado DOM del puente
// de hover. Se ordena por grado — lo más conectado arriba, que es lo más
// probado, no lo alfabéticamente primero.
const items = posicionado.nodes
  .filter((n) => n.kind === "skill")
  .sort((a, b) => b.degree - a.degree || a.label.localeCompare(b.label, "es"));

const conEvidencia = items.filter((n) => n.degree > 0).length;
const afinidades = posicionado.edges.filter((e) => e.kind === "afinidad").length;

// skillId → nombre canónico, para el stack de cada proyecto. Se arma acá y no
// en el componente: `view.skills` viene agrupado por categoría, y aplanarlo es
// trabajo de la página, no del componente tonto.
const nombreDeSkill = new Map(
  Object.values(view.skills).flat().map((s) => [s.id, s.name]),
);
---

<Base
  title={`${identity.fullName} — ${identity.searchTitle}`}
  description={identity.summary.short}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <style is:inline set:html={hoverCss} slot="head" />

  <div class="lab">
    <canvas class="lab__campo" data-lab-campo aria-hidden="true"></canvas>

    {/*
      Índice y contacto en una píldora que acompaña el scroll. Reemplaza a los
      botones del hero: el CTA de descarga ya lo cubre el flotante de abajo, y
      dos botones grandes arriba empujaban el mapa fuera de la primera pantalla.

      `href="#cv"` y NO `/cv` — esa ruta existe solo para imprimir el PDF, y
      `landing-unica.check.ts` verifica que nadie la linkee.

      Sin JS la píldora ya está fija y es usable: el script solo le agrega el
      retraso al desplazarse. Por eso el `transform` inicial vive en el CSS.
    */}
    <div class="barra" data-pildora>
      <header class="pildora">
        <nav class="pildora__nav" aria-label="Secciones">
          <a href="#mapa">Mapa</a>
          <a href="#proyectos">Proyectos</a>
          <a href="#cv">CV</a>
        </nav>

        <span class="pildora__sep" aria-hidden="true"></span>

        <ul class="pildora__contacto">
          <li>
            <a href={`mailto:${identity.contact.email}`}>
              <span class="pildora__largo">{identity.contact.email}</span>
              <span class="pildora__corto">Email</span>
            </a>
          </li>
          {identity.links.map((link) => (
            <li><a href={link.url} rel="me noopener">{link.label}</a></li>
          ))}
        </ul>
      </header>

      {/*
        El CTA vive al lado del índice y no en una esquina: es la única acción
        de la página, y separarla del resto de la navegación la volvía un
        elemento suelto. Comparte el desfase de la barra, así que las dos
        piezas se mueven como una.
      */}
      <a
        class="descarga"
        href="/cv.pdf"
        download="Nicolas-Cribb-Barbaro-Full-Stack-Developer.pdf"
      >
        <span class="descarga__flecha" aria-hidden="true">↓</span>
        <span class="pildora__largo">Descargar CV</span>
        <span class="pildora__corto">CV</span>
      </a>
    </div>

    <main class="lab__contenido">
      <section class="home lab__hero">
        <p class="home__kicker">{identity.brandTitle}</p>
        <h1 class="home__name">{identity.fullName}</h1>
        <p class="home__role">
          {identity.searchTitle} · {formatSeniority(view.yearsOfExperience)} · {identity.location.city}, {identity.location.country}
        </p>
        <p class="home__tagline">{identity.tagline.short}</p>
      </section>

      <section id="mapa" class="lab__mapa-seccion">
        <div class="lab__intro">
          <h2 class="lab__titulo">Mapa de conocimiento</h2>
          <p class="lab__bajada">
            Los logros no viven adentro de cada trabajo: viven sueltos y se cruzan por
            tecnología, por rol y por proyecto. Esto es ese cruce, dibujado.
          </p>
          <dl class="lab__cifras">
            <div><dt>Nodos</dt><dd>{posicionado.nodes.length}</dd></div>
            <div><dt>Conexiones</dt><dd>{posicionado.edges.length}</dd></div>
            <div><dt>Por afinidad</dt><dd>{afinidades}</dd></div>
          </dl>
        </div>

        {/*
          `tabindex` y `role` van sobre el CONTENEDOR, no sobre el canvas: el
          canvas es `pointer-events: none` y no puede recibir nada. Acá se
          escuchan el arrastre, el click y las flechas.
        */}
        <div
          class="lab__mapa"
          tabindex="0"
          role="application"
          aria-label="Mapa de conocimiento. Arrastrá para rotar, hacé click en un nodo para ver qué lo respalda. Las flechas también rotan."
        >
          <GraphSvg
            mapa={mapa}
            totalNodos={posicionado.nodes.length}
            totalAristas={posicionado.edges.length}
          />
          <canvas class="lab__canvas" data-lab-grafo aria-hidden="true"></canvas>
          {/*
            Las etiquetas del 3D viven en el DOM, no en WebGL: un atlas de fuente
            costaría más que toda la escena y el texto saldría borroso. Están
            server-rendered y ocultas hasta que el 3D monta; el SVG trae las suyas.
          */}
          <div class="lab__etiquetas" aria-hidden="true">
            {posicionado.nodes
              .filter((n) => n.kind === "role" || n.kind === "project")
              .map((n) => (
                <span class={`lab__etiqueta-3d lab__etiqueta-3d--${n.kind}`} data-lab-etiqueta data-node={n.id}>
                  {n.label}
                </span>
              ))}
          </div>
          <div class="lab__tooltip" data-lab-tooltip aria-hidden="true"></div>

          {/*
            El panel de detalle lo llena el JS con `textContent` sobre elementos
            creados a mano — nunca `innerHTML`. `aria-live="polite"` hace que un
            lector de pantalla anuncie el nodo enfocado sin interrumpir.
          */}
          <div class="lab__panel" data-lab-panel role="status" aria-live="polite"></div>

          <p class="lab__pista" aria-hidden="true">Arrastrá para rotar · click en un nodo</p>
        </div>

        <div class="lab__indice">
          <h3 class="lab__indice-titulo">
            Stack <span class="lab__indice-nota">{conEvidencia} de {items.length} con evidencia</span>
          </h3>
          <ul class="lab__lista">
            {items.map((n) => (
              <li>
                <span
                  id={ID_ITEM(n.id)}
                  class={n.degree > 0 ? "lab__item" : "lab__item lab__item--hueco"}
                  data-node={n.id}
                  tabindex="0"
                >
                  <span class="lab__punto" aria-hidden="true"></span>
                  {n.label}
                  {n.degree > 0 && <span class="lab__grado">{n.degree}</span>}
                </span>
              </li>
            ))}
          </ul>
          <p class="lab__nota">
            Las {items.length - conEvidencia} tecnologías sin conexiones son reales: las uso,
            pero todavía no escribí el logro que lo demuestre. Van huecas y chicas, agrupadas
            en el núcleo. El mapa muestra el hueco en vez de taparlo.
          </p>
        </div>
      </section>

      <section id="proyectos" class="proyectos-seccion">
        <h2 class="lab__titulo">Proyectos</h2>
        <ListaProyectos proyectos={view.projects} nombreDeSkill={nombreDeSkill} />
      </section>

      <section id="cv" class="cv">
        <h2 class="cv__seccion-titulo">Currículum</h2>

        <Section title="Perfil">
          <p class="profile">{viewCv.identity.summary.short}</p>
        </Section>

        <Section title="Habilidades técnicas">
          <SkillList skills={viewCv.skills} />
        </Section>

        <Section title="Experiencia">
          {viewCv.experience.map((role) => <RoleBlock role={role} />)}
        </Section>

        <Section title="Educación">
          {viewCv.education.map((e) => (
            <div class="entry">
              <p class="entry__title">{e.degree}{e.field && <> — {e.field}</>}</p>
              <p class="entry__meta">
                {e.institution}
                {e.end && <> · {e.start ? formatDateRange(e.start, e.end) : formatYearMonth(e.end)}</>}
                {e.status === "partial" && <> · Cursado parcial</>}
                {e.status === "in-progress" && <> · En curso</>}
              </p>
            </div>
          ))}
        </Section>

        <Section title="Idiomas">
          {viewCv.languages.map((l) => (
            <p class="skill-group">
              <span class="skill-group__label">{l.name}:</span>{" "}
              {l.level === "native" ? "Nativo" : l.level}
            </p>
          ))}
        </Section>
      </section>
    </main>

    {/*
      La línea de privacidad. Clarity usa cookies y graba sesiones; decirlo es
      lo mínimo razonable si llega tráfico de la UE (docs/05 §5). Vive acá y no
      en `Base.astro` porque la analítica tampoco vive ahí: si mañana se saca,
      esta línea se va con ella y no queda huérfana en `/cv`.

      Cloudflare Web Analytics se nombra aparte porque NO es lo mismo: no usa
      cookies ni identifica a nadie. Meter las dos en la misma frase daría a
      entender que las dos graban, y sería exagerar en la dirección que no
      corresponde.
    */}
    <footer class="pie">
      <p>
        Uso Microsoft Clarity para ver qué partes de esta página se leen: mide
        clicks y scroll, y graba sesiones anónimas. Usa cookies.{" "}
        <a
          href="https://privacy.microsoft.com/privacystatement"
          rel="noopener noreferrer"
          target="_blank">Su política de privacidad</a>. También uso Cloudflare
        Web Analytics para el tráfico y la velocidad de carga: no usa cookies ni
        identifica visitantes.
      </p>
    </footer>
  </div>

  {/*
    El beacon de Cloudflare Web Analytics.

    Va a mano y NO desde el dashboard de Pages. Habilitarlo ahí hace que
    Cloudflare inyecte el snippet en TODO el sitio en el próximo deploy, y eso
    metería JavaScript en `/cv` — que es de donde Browser Rendering imprime el
    PDF. Peor: la inyección pasa en el borde, después del build, así que
    `no-client-js.check.ts` no la vería. El invariante se rompería en producción
    con todos los checks en verde. Ver docs/05 §3 paso 8.

    `is:inline` explícito: Astro lo trataría así igual por tener atributos, pero
    declararlo evita un hint más de `astro(4000)` (deuda técnica §4).

    Sin Subresource Integrity, por lo mismo que el tag de Clarity: el beacon lo
    actualiza Cloudflare del lado del servidor y un hash fijo lo rompería en la
    primera versión nueva. Lo que acota el riesgo es dónde corre — solo la
    landing, que no tiene formularios ni credenciales.
  */}
  {beaconCloudflare && (
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: beaconCloudflare })}
    />
  )}

  <script type="application/json" data-lab-datos set:html={datosGrafo} />
  <script>
    // La analítica va PRIMERO, y no es un descuido: `Clarity.init` solo inyecta
    // un `<script async>` y su propio try/catch se traga cualquier error, así
    // que no puede tirar. `iniciar()` sí toca el DOM y puede fallar en un
    // dispositivo raro — al revés, un fallo del mapa se llevaría puesta la
    // medición, que es justo lo que sirve para entender ese fallo.
    import { iniciarAnalitica } from "../scripts/analitica";
    import { iniciar } from "../scripts/lab/boot";
    iniciarAnalitica();
    iniciar();
  </script>
</Base>
