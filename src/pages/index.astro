---
/**
 * The home: the landing (`src/components/v2/Landing.astro`), in Spanish.
 *
 * This file's own job is what has to be a direct child of `<Base>`: the
 * `<head>` (title, Open Graph, hreflang, the JSON-LD `Person`), the `js`
 * class the chapters' CSS keys on, and the analytics. Everything visible is
 * shared with `/en/` through `Landing`.
 *
 * It ships JavaScript (`PAGES_WITH_JS` in `scripts/pages-with-js.ts`): the
 * chapters are scroll-driven on purpose (DeltaDictum: landing-v2/direction).
 * Without JS every word is still in the HTML.
 */
import Base from "../layouts/Base.astro";
import { content } from "@content";
import { buildPersonJsonLd } from "../lib/jsonld";
import { BUILD_META, LANDING_HEAD_SCRIPT } from "../lib/landing-head";
import Landing from "../components/v2/Landing.astro";
import Analytics from "../components/Analytics.astro";

import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/800.css";
import "../styles/tokens.css";
import "../styles/chrome.css";
import "../styles/v2.css";

const view = await content.getView("portfolio", "es");
const { identity } = view;
const jsonLd = buildPersonJsonLd(view, new URL(Astro.site!));
// This deploy's id, as build.json serves it: what the loader's "seen" flag
// is stamped with (src/lib/landing-head.ts). In a <meta>, not in the
// script: the script's CSP hash must not change per deploy.
const build = process.env.CF_PAGES_COMMIT_SHA ?? "local";
---

{/*
  `shareable` (Open Graph + Twitter Card) and `hreflang` are opt-in in
  `Base.astro`: only the two landings carry them.
*/}
<Base
  locale={view.locale}
  title={`${identity.fullName} — ${identity.searchTitle}`}
  description={identity.summary.short}
  shareable
  hreflang
>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(jsonLd)} />
  <meta name={BUILD_META} content={build} slot="head" />
  <script is:inline slot="head" set:html={LANDING_HEAD_SCRIPT} />

  <Analytics />
  <Landing view={view} />
</Base>
