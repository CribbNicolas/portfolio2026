---
/**
 * The CV in HTML. The PDF comes out of this same page (scripts/build-pdf.ts),
 * so HTML and PDF cannot drift apart: there is one layout.
 *
 * `cv-ats` surface. For now it is the only one rendered; adding a designed `cv`
 * later means adding another page asking for another surface, without touching
 * any of this.
 *
 * Two things are deliberately NOT rendered:
 *  - `LanguageSkill.note`: today it holds a TODO and `resolveView` does not
 *    filter `languages`. If it printed, the TODO would reach the PDF.
 *  - `Project.outcome`: two of the three projects have their outcome as a TODO,
 *    and the projects already live in the portfolio. The CV carries no projects
 *    section.
 */
import Base from "../layouts/Base.astro";
import Header from "../components/cv/Header.astro";
import Section from "../components/cv/Section.astro";
import RoleBlock from "../components/cv/RoleBlock.astro";
import SkillList from "../components/cv/SkillList.astro";
import { content, formatDateRange, formatYearMonth } from "@content";
import { buildPersonJsonLd } from "../lib/jsonld";

import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/800.css";
import "../styles/tokens.css";
import "../styles/cv.css";

const view = await content.getView("cv-ats", "es");
const { identity } = view;

// The JSON-LD comes from `public-api`, not from `cv-ats`: two different
// surfaces loaded on the same page.
const publicView = await content.getView("public-api", "es");
const jsonLd = buildPersonJsonLd(publicView, new URL(Astro.site!));
---

<Base
  title={`CV — ${identity.fullName}, ${identity.searchTitle}`}
  description={identity.summary.short}
>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(jsonLd)} />

  {/*
    `/cv` exists so `build-pdf.ts` can print it, not to be visited: the reader
    reaches the CV through the landing's `#cv` anchor. Indexing it would split
    the single visit in two, and whoever landed here would see neither the map
    nor the projects. `scripts/single-landing.check.ts` verifies this.
  */}
  <meta name="robots" content="noindex, follow" slot="head" />
  <main class="cv">
    <Header identity={identity} />

    <Section title="Perfil">
      <p class="profile">{identity.summary.short}</p>
    </Section>

    <Section title="Habilidades técnicas">
      <SkillList skills={view.skills} />
    </Section>

    <Section title="Experiencia">
      {view.experience.map((role) => <RoleBlock role={role} />)}
    </Section>

    <Section title="Educación">
      {view.education.map((e) => (
        <div class="entry">
          <p class="entry__title">{e.degree}{e.field && <> — {e.field}</>}</p>
          <p class="entry__meta">
            {e.institution}
            {/* Without `start` there is no range: formatDateRange(end, end) would print
                "02/2022 — 02/2022", que se lee como un error de carga. */}
            {e.end && <> · {e.start ? formatDateRange(e.start, e.end) : formatYearMonth(e.end)}</>}
            {e.status === "partial" && <> · Cursado parcial</>}
            {e.status === "in-progress" && <> · En curso</>}
          </p>
        </div>
      ))}
    </Section>

    <Section title="Idiomas">
      {view.languages.map((l) => (
        <p class="skill-group">
          <span class="skill-group__label">{l.name}:</span>{" "}
          {l.level === "native" ? "Nativo" : l.level}
        </p>
      ))}
    </Section>
  </main>
</Base>
