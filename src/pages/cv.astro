---
/**
 * The CV in HTML. The PDF comes out of this same page (scripts/build-pdf.ts),
 * so HTML and PDF cannot drift apart: there is one layout — now shared with
 * `/en/cv` too, via `CvDocument.astro`. This file's only job is the page shell:
 * `<Base>`, the `noindex` meta and the JSON-LD, all of which have to be direct
 * children of `<Base>` to land inside `<head>` (see `CvDocument.astro`'s header
 * comment for why they could not move into the shared component).
 */
import Base from "../layouts/Base.astro";
import CvDocument from "../components/cv/CvDocument.astro";
import { content } from "@content";
import { buildPersonJsonLd } from "../lib/jsonld";

import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/800.css";
import "../styles/tokens.css";
import "../styles/cv.css";

const locale = "es";

// `public-api` and not `cv-ats`: this is the surface the JSON-LD is built
// from, and `identity.fullName`/`searchTitle`/`summary.short` do not vary
// between surfaces (rule 8 only filters phone/street address), so one fetch
// covers both the title below and the JSON-LD. `CvDocument` fetches `cv-ats`
// on its own for the body.
const view = await content.getView("public-api", locale);
const { identity } = view;
const jsonLd = buildPersonJsonLd(view, new URL(Astro.site!));
---

<Base
  locale={locale}
  title={`CV — ${identity.fullName}, ${identity.searchTitle}`}
  description={identity.summary.short}
>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(jsonLd)} />

  {/*
    `/cv` exists so `build-pdf.ts` can print it, not to be visited: the reader
    reaches the CV through the landing's `#cv` anchor. Indexing it would split
    the single visit in two, and whoever landed here would see neither the map
    nor the projects. `scripts/single-landing.check.ts` verifies this.
  */}
  <meta name="robots" content="noindex, follow" slot="head" />
  <CvDocument locale={locale} />
</Base>
