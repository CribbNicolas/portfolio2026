---
/**
 * The English home. Same shell as `../index.astro`, same shared `Landing`,
 * its own dataset (`content.en.json`) and copy (`landing-copy.ts`). See
 * `../index.astro`'s header comment for what lives here and what does not.
 *
 * `HREFLANG` is the same fixed pair on both landings: each page in an
 * `hreflang` set declares the whole set, itself included.
 */
import Base from "../../layouts/Base.astro";
import { content } from "@content";
import { buildPersonJsonLd } from "../../lib/jsonld";
import Landing from "../../components/v2/Landing.astro";
import Analytics from "../../components/Analytics.astro";

import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/800.css";
import "../../styles/tokens.css";
import "../../styles/v2.css";

const view = await content.getView("portfolio", "en");
const { identity } = view;
const jsonLd = buildPersonJsonLd(view, new URL(Astro.site!));
---

<Base
  locale={view.locale}
  title={`${identity.fullName} — ${identity.searchTitle}`}
  description={identity.summary.short}
  shareable
  hreflang
>
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify(jsonLd)} />
  <script is:inline slot="head">
    document.documentElement.classList.add("js");
  </script>

  <Analytics />
  <Landing view={view} />
</Base>
