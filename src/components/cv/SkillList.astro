---
/**
 * Skills grouped by category, as running text separated by commas.
 *
 * No progress bars and no level dots: no parser reads them and they make a
 * technical reader suspicious (docs/03 §2 and CONTRACT §4).
 *
 * The canonical `Skill.name` is printed and NEVER the `aliases`: repeating
 * variants of the same term LOWERS the score in semantic matchers (docs/01 §3).
 * The aliases are data for the per-posting generator, not CV text.
 *
 * The grouping and its order come from `content/schema/skill-groups.ts`, shared
 * with `/llms.txt`. They used to be two separate lists and they diverged.
 */
import type { ContentView, Locale } from "@content";
import { groupedSkills } from "@content";

interface Props {
  skills: ContentView["skills"];
  locale: Locale;
}

const { skills, locale } = Astro.props;
const groups = groupedSkills(skills, locale);
---

{groups.map(({ label, skills: list }) => (
  <p class="skill-group">
    <span class="skill-group__label">{label}:</span>{" "}
    {list.map((s) => s.name).join(", ")}
  </p>
))}
