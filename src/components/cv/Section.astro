---
/**
 * A CV section. The names are supplied by the caller, and they have to be the
 * standard ones from docs/03 §2 (`Perfil`, `Habilidades técnicas`, ...): a
 * parser maps those headings to fields, and "Mi stack" maps to nothing.
 *
 * Por eso tampoco se le agregan prefijos decorativos ni marcadores en ::before:
 * the text extracted from the PDF has to say exactly the standard name.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="section">
  <h2 class="section__title">{title}</h2>
  <slot />
</section>
