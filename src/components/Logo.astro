---
/**
 * The complete brand: the open ring with the N inside.
 *
 * They are two halves of one system. The ring alone lives in
 * `public/favicon.svg` and is the small icon; here the N is added, and it only
 * appears once there is room to read it. The ring IS the C of the surname, so
 * the container is not decoration: between the two pieces they say «NC».
 *
 * Unlike the favicon, this SVG DOES inherit the page CSS, so the colors come
 * from `var(--accent)` and `var(--ink)` instead of being written by hand.
 * That is why dark mode needs not a single line here: the tokens already
 * redefine themselves in `tokens.css`. The favicon repeats the hex values
 * because it has no choice, and that is the only place they are duplicated.
 *
 * It goes inline and not as an `<img src>`: one more request for 300 bytes does
 * not pay for itself, and an `<img>` could not read the tokens.
 */
import { RING_PATH, BRAND_VIEWBOX, N_WEIGHT, N_PATH } from "../lib/brand";

interface Props {
  /** Side of the square, in px. The drawing box is always 32×32. */
  size?: number;
  /**
   * Text for screen readers. With `null` the logo is decorative: the right
   * choice when the name is already written next to it.
   */
  label?: string | null;
  class?: string;
}

const { size = 26, label = "Nicolás Cribb", class: className } = Astro.props;

// The geometry does NOT live here: it comes from `src/lib/brand.ts`, the single
// source shared by this logo and the Open Graph card generator. The right leg of
// the N overshoots the opening of the ring on purpose — that is what ties the
// two pieces into one figure instead of leaving a letter propped inside a ring.
---

<svg
  class={className}
  viewBox={BRAND_VIEWBOX}
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-label={label ?? undefined}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <path d={RING_PATH} fill="var(--accent)" />
  <path
    d={N_PATH}
    fill="none"
    stroke="var(--ink)"
    stroke-width={N_WEIGHT}
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
