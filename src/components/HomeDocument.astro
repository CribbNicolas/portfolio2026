---
/**
 * The brief view's body (`/brief`, `/en/brief`): the floating pill, the
 * hero, the projects and the CV section — the landing's facts with none of
 * its chapters. Shared by both locales, parameterized by `view.locale`.
 *
 * Until 2026-10-29 this was the home and carried a 3D knowledge map; the map
 * was removed when the chaptered landing (`components/v2/Landing.astro`) took
 * `/`. What is left links back to that landing and keeps the reader in the
 * brief view across the language switch.
 *
 * Deliberately NOT responsible for anything that has to be a direct child of
 * `<Base>` (the analytics stay in the calling page). Everything else it
 * needs (the CV surface, chrome copy, both PDFs' file names) it derives from
 * `view`, same as `CvDocument`.
 *
 * `locale` is NOT a separate prop: it is read off `view.locale`. Two
 * independent props (one prior version of this file took both) make "English
 * chrome over the Spanish view" a typo away — swap the `view` a caller passes
 * without also swapping `locale` and every check still passes, because
 * nothing compares the two. `resolveView` stamps `locale` from the same
 * dataset the rest of the view was resolved from, so deriving it here instead
 * makes that divergence unrepresentable rather than merely untested.
 */
import type { ContentView, Locale } from "@content";
import { content, formatSeniority, formatDateRange, formatYearMonth, pdfFilename, MESSAGES } from "@content";
import { ANCHORS, LOCALE_PATHS, OTHER_LOCALE, anchorScrollCss } from "../lib/anchors";
import { LANDING } from "../lib/landing-copy";
import Logo from "./Logo.astro";
import LocaleSwitch from "./LocaleSwitch.astro";
import ProjectList from "./projects/ProjectList.astro";
import Section from "./cv/Section.astro";
import RoleBlock from "./cv/RoleBlock.astro";
import SkillList from "./cv/SkillList.astro";

interface Props {
  view: ContentView;
}

const { view } = Astro.props;
const locale = view.locale;
const { identity } = view;
const m = MESSAGES[locale];
const anchors = ANCHORS[locale];

// Rule 7: `cv-ats` cuts by priority (cutoff 3) and caps at 5 achievements per
// role; `portfolio` (the `view` prop) cuts nothing. This section has to show
// EXACTLY what gets printed, because the download button promises "the CV".
const viewCv = await content.getView("cv-ats", locale);

// Both PDFs are offered on both landings, so both datasets are needed
// regardless of which locale this page is: the current locale's file name
// comes from its own `updatedAt`, and so does the other's — using the
// current locale's date for both would silently mislabel whichever PDF is
// not this page's own.
const other: Locale = OTHER_LOCALE[locale];
const [datasetOwn, datasetOther] = await Promise.all([
  content.getDataset(locale),
  content.getDataset(other),
]);
const datasetOf: Record<Locale, typeof datasetOwn> = {
  [locale]: datasetOwn,
  [other]: datasetOther,
} as Record<Locale, typeof datasetOwn>;
/** The file's own language, not the page's — same reason LocaleSwitch
 *  labels the two sides ES/EN rather than translating "Spanish". */
const PDF_LABEL: Record<Locale, string> = { es: "Español", en: "English" };
const pdfOrder: Locale[] = [locale, other];

// skillId → canonical name, for each project's stack. Built here and not in
// `ProjectList`: `view.skills` arrives grouped by category, and flattening it
// is this component's job, not the dumb one's.
const skillNameById = new Map(
  Object.values(view.skills).flat().map((s) => [s.id, s.name]),
);
---

<div class="lab">
  <style is:inline set:html={anchorScrollCss()} />

  {/*
    Index and contact in a pill that follows the scroll. It replaces the hero
    buttons: the download CTA is already covered by the floating one below, and
    two large buttons up top pushed the map off the first screen.

    `href="#cv"` and NOT `/cv` — that route exists only to print the PDF, and
    `single-landing.check.ts` verifies nobody links to it.

    Without JS the pill is already fixed and usable: the script only adds the
    lag while scrolling. That is why the initial `transform` lives in the CSS.
  */}
  <div class="bar" data-pill>
    <header class="pill">
      {/*
        The logo is decorative on purpose (`label={null}`): the name is already
        in the hero's `<h1>`, and a screen reader announcing it again here only
        adds noise before the index.
      */}
      <Logo class="pill__logo" size={26} label={null} />

      <span class="pill__sep" aria-hidden="true"></span>

      {/*
        The section index (map / projects / CV) used to sit here. It is out on
        BOTH sizes, not hidden under a media query: the pill's children do not
        shrink (`white-space: nowrap`, `flex: none`), so past its own width the
        bar does not wrap — the download button rides over the mail link and the
        social links ride under the language switch. Three anchors were the
        cheapest thing in the bar to give up: the page scrolls in one column and
        every section is a screen away.
      */}

      <ul class="pill__contact">
        <li class="pill__mail">
          {/* The address itself at every width, never a "Email" label: the
              address is the thing you can act on — read it off the screen,
              copy it, tap it — and a label that hides it makes the bar's one
              piece of contact information depend on tapping to find out what
              it even is. */}
          <a href={`mailto:${identity.contact.email}`}>{identity.contact.email}</a>
        </li>
        {identity.links.map((link) => (
          <li class="pill__social"><a href={link.url} rel="me noopener">{link.label}</a></li>
        ))}
      </ul>

      <span class="pill__sep" aria-hidden="true"></span>

      {/* The language switch. A link, not a script — see LocaleSwitch.astro. */}
      <LocaleSwitch locale={locale} />
    </header>

    {/*
      One button, both PDFs. A native `popover` so opening it needs no JS —
      the landing already ships a bundle for the map, but the download has
      to work with that bundle blocked, and `/cv` stays at zero either way.
      The visible label is always "CV": the language choice lives in the
      modal, which is the only place both files can sit without crowding
      the pill on a phone.
    */}
    <button
      type="button"
      class="download"
      popovertarget="cv-download"
      aria-haspopup="dialog"
      aria-controls="cv-download"
      aria-label={m.downloadCv}
    >
      <span class="download__arrow" aria-hidden="true">↓</span>
      CV
    </button>
  </div>

  {/*
    Lives outside `.bar` on purpose: the bar carries `transform`, which
    would become the containing block of a `position: fixed` popover in
    any browser that fails to promote it to the top layer. The button
    still opens it by id.
  */}
  <div
    id="cv-download"
    popover
    class="download-menu"
    role="dialog"
    aria-labelledby="cv-download-title"
  >
    <div class="download-menu__head">
      <p id="cv-download-title" class="download-menu__title">{m.downloadCv}</p>
      <button
        type="button"
        class="download-menu__close"
        popovertarget="cv-download"
        popovertargetaction="hide"
        aria-label={m.closeDialog}
      >
        ×
      </button>
    </div>
    <div class="download-menu__list">
      {pdfOrder.map((lang) => (
        <a
          href={LOCALE_PATHS[lang].pdf}
          download={pdfFilename(lang, datasetOf[lang].updatedAt)}
          lang={lang}
          hreflang={lang}
        >
          <span class="download-menu__lang">{PDF_LABEL[lang]}</span>
          <span class="download-menu__file">{pdfFilename(lang, datasetOf[lang].updatedAt)}</span>
        </a>
      ))}
    </div>
  </div>

  <main class="lab__content">
    <section class="home lab__hero">
      <h1 class="home__name">{identity.fullName}</h1>
      <p class="home__role">
        {identity.searchTitle} · {formatSeniority(view.yearsOfExperience, locale)} · {identity.location.city}, {identity.location.country}
      </p>
      <p class="home__guided"><a href={LOCALE_PATHS[locale].home}>{LANDING[locale].guidedLink} <span aria-hidden="true">→</span></a></p>
    </section>

    <section id={anchors.projects} class="projects-section">
      <h2 class="lab__title">{m.projectsTitle}</h2>
      <ProjectList projects={view.projects} skillNameById={skillNameById} locale={locale} />
    </section>

    <section id={anchors.cv} class="cv">
      <h2 class="cv__section-title">{m.cvTitle}</h2>

      <Section title={m.sectionProfile}>
        <p class="profile">{viewCv.identity.summary.short}</p>
      </Section>

      <Section title={m.sectionSkills}>
        <SkillList skills={viewCv.skills} locale={locale} />
      </Section>

      <Section title={m.sectionExperience}>
        {viewCv.experience.map((role) => <RoleBlock role={role} locale={locale} />)}
      </Section>

      <Section title={m.sectionEducation}>
        {viewCv.education.map((e) => (
          <div class="entry">
            <p class="entry__title">{e.degree}{e.field && <> — {e.field}</>}</p>
            <p class="entry__meta">
              {e.institution}
              {e.end && <> · {e.start ? formatDateRange(e.start, e.end, locale) : formatYearMonth(e.end, locale)}</>}
              {e.status === "partial" && <> · {m.studyPartial}</>}
              {e.status === "in-progress" && <> · {m.studyInProgress}</>}
            </p>
          </div>
        ))}
      </Section>

      <Section title={m.sectionLanguages}>
        {viewCv.languages.map((l) => (
          <p class="skill-group">
            <span class="skill-group__label">{l.name}:</span>{" "}
            {l.level === "native" ? m.levelNative : l.level}
          </p>
        ))}
      </Section>
    </section>
  </main>

  {/*
    The privacy line. Clarity uses cookies and records sessions; saying so is
    the least that is reasonable if EU traffic arrives. It lives
    here and not in `Base.astro` because the analytics do not live there
    either: if they are removed tomorrow, this line goes with them and is not
    left orphaned on `/cv`.

    Cloudflare Web Analytics is named separately because it is NOT the same:
    it uses no cookies and identifies nobody. Putting both in one sentence
    would suggest both record, and that would overstate in the direction that
    does not apply.
  */}
  <footer class="footer">
    <p>{m.footerPrivacyIntro}<a
        href="https://privacy.microsoft.com/privacystatement"
        rel="noopener noreferrer"
        target="_blank">{m.footerPrivacyLinkText}</a>{m.footerPrivacyOutro}</p>
  </footer>
</div>
