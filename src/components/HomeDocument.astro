---
/**
 * The brief view's body (`/brief`, `/en/brief`): the floating pill, the
 * hero, the projects and the CV section — the landing's facts with none of
 * its chapters. Shared by both locales, parameterized by `view.locale`.
 *
 * Until 2026-10-29 this was the home and carried a 3D knowledge map; the map
 * was removed when the chaptered landing (`components/v2/Landing.astro`) took
 * `/`. What is left links back to that landing and keeps the reader in the
 * brief view across the language switch.
 *
 * Deliberately NOT responsible for anything that has to be a direct child of
 * `<Base>` (the analytics stay in the calling page). Everything else it
 * needs (the CV surface, chrome copy, both PDFs' file names) it derives from
 * `view`, same as `CvDocument`.
 *
 * `locale` is NOT a separate prop: it is read off `view.locale`. Two
 * independent props (one prior version of this file took both) make "English
 * chrome over the Spanish view" a typo away — swap the `view` a caller passes
 * without also swapping `locale` and every check still passes, because
 * nothing compares the two. `resolveView` stamps `locale` from the same
 * dataset the rest of the view was resolved from, so deriving it here instead
 * makes that divergence unrepresentable rather than merely untested.
 */
import type { ContentView, Locale } from "@content";
import {
  content,
  formatDateRange,
  formatDuration,
  formatMetricLabeled,
  formatRoleTitleParts,
  formatSeniority,
  formatYearMonth,
  groupedSkills,
  pdfFilename,
  MESSAGES,
} from "@content";
import { ANCHORS, LOCALE_PATHS, OTHER_LOCALE, anchorScrollCss } from "../lib/anchors";
import { LANDING } from "../lib/landing-copy";
import { splitFigures } from "../lib/highlight";
import { RING_PATH, BRAND_VIEWBOX } from "../lib/brand";
import Logo from "./Logo.astro";
import CvPick from "./CvPick.astro";

interface Props {
  view: ContentView;
}

const { view } = Astro.props;
const locale = view.locale;
const { identity } = view;
const m = MESSAGES[locale];
const anchors = ANCHORS[locale];

// Rule 7: `cv-ats` cuts by priority (cutoff 3) and caps at 5 achievements per
// role; `portfolio` (the `view` prop) cuts nothing. This section has to show
// EXACTLY what gets printed, because the download button promises "the CV".
const viewCv = await content.getView("cv-ats", locale);

const t = LANDING[locale];
const other: Locale = OTHER_LOCALE[locale];

// Both PDFs, each named from ITS dataset's `updatedAt`: using one date for
// both would mislabel whichever is not this page's own. The halves are
// fixed: Spanish left, English right, as in the landing's close.
const datasets = { es: await content.getDataset("es"), en: await content.getDataset("en") };
const cvLinks = (["es", "en"] as const).map((lang) => ({
  lang,
  short: lang === "es" ? "ESP" : "EN",
  href: LOCALE_PATHS[lang].pdf,
  file: pdfFilename(lang, datasets[lang].updatedAt),
  label: t.cvHalfLabel[lang],
}));

// The CV sections read `cv-ats` (what the PDF prints); the projects, which
// the PDF does not carry, read the portfolio view.
const skillGroups = groupedSkills(viewCv.skills, locale);
const skillNameById = new Map(Object.values(viewCv.skills).flat().map((s) => [s.id, s.name]));
/** A role's stack: every skill its printed achievements cite, in order. */
const stackOf = (role: (typeof viewCv.experience)[number]) =>
  [...new Set(role.achievements.flatMap((a) => a.skillIds))].flatMap((id) => skillNameById.get(id) ?? []);
const languagesLine = viewCv.languages
  .map((l) => `${l.name} ${l.level === "native" ? m.levelNative.toLowerCase() : l.level}`)
  .join(" · ");
/** What is shown next to a project's name. `archived` is not labelled. */
const statusLabel: Partial<Record<string, string>> = {
  "in-progress": m.projectStatusInProgress,
  prototype: m.projectStatusPrototype,
};
---

<div class="lab" id="top">
  <style is:inline set:html={anchorScrollCss()} />

  {/*
    The same dock as the guided landing (chrome.css): the mark back to the
    top, the CV, and the other language — here, the other language's brief
    view. The CV control opens the dialog below with no script
    (`popovertarget`), so the download works with JavaScript off too.
  */}
  <nav class="dock" aria-label={t.dockLabel}>
    <a class="dock__logo" href="#top"><Logo size={22} /></a>
    <button class="dock__cv" type="button" popovertarget="cv-pick">{m.downloadCv}</button>
    <a class="dock__lang" href={LOCALE_PATHS[other].brief} hreflang={other} lang={other}>{t.otherLocaleShort}<span class="visually-hidden"> · {t.otherLocaleName}</span></a>
  </nav>

  {/* The CV dialog: the landing's C, still (CvPick.astro). */}
  <CvPick cvLinks={cvLinks} kicker={`${m.downloadCv} · ${t.cvModalPick}`} closeLabel={m.closeDialog} />

  {/*
    The background: the brand's C, the landing's turning ring, blurred into
    light behind the text, with a slow parallax as the page scrolls (author,
    2026-10-29). Pure CSS (brief.css): no script, no canvas.
  */}
  <div class="brief__backdrop" aria-hidden="true">
    <svg class="brief__ring" viewBox={BRAND_VIEWBOX}>
      <path d={RING_PATH} fill="var(--accent)" />
    </svg>
  </div>

  {/*
    The CV, laid out like the PDF (`cv-ats`: same sections, same order, same
    cut) so the brief view and the download say the same thing, plus the
    projects. What a reader scans for is set apart: figures inside the text
    (`splitFigures`), the metrics, the company of each role, its stack, and
    the skills declared `core`.
  */}
  <main class="brief" id={anchors.cv}>
    <header class="brief__head" data-reveal>
      <p class="brief__kicker">{identity.searchTitle} · {identity.brandTitle}</p>
      <h1 class="brief__name">{identity.fullName}</h1>
      <p class="brief__tagline">{identity.tagline.short}</p>
      <ul class="brief__facts">
        <li><strong>{formatSeniority(view.yearsOfExperience, locale)}</strong></li>
        <li>{identity.location.city}, {identity.location.country} · {identity.location.timezone}</li>
        <li>{languagesLine}</li>
      </ul>
      {/* Contact, as the PDF's header carries it. */}
      <p class="brief__contact">
        <a href={`mailto:${identity.contact.email}`}>{identity.contact.email}</a>
        {identity.links.map((l) => <a href={l.url} rel="me noopener">{l.label}</a>)}
      </p>
      <div class="brief__actions">
        <button class="btn btn--solid" type="button" popovertarget="cv-pick">{m.downloadCv}</button>
        <a class="btn" href={LOCALE_PATHS[locale].home}>{t.guidedLink} <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <section class="brief__section" aria-labelledby="brief-profile" data-reveal>
      <h2 class="brief__h" id="brief-profile">{m.sectionProfile}</h2>
      <p class="brief__profile">{viewCv.identity.summary.short}</p>
    </section>

    <section class="brief__section" aria-labelledby="brief-skills" data-reveal>
      <h2 class="brief__h" id="brief-skills">{m.sectionSkills}</h2>
      <dl class="brief__skills">
        {skillGroups.map((g) => (
          <div class="brief__skill-group">
            <dt>{g.label}</dt>
            <dd>
              <ul>
                {g.skills.map((s) => (
                  <li class:list={{ "is-core": s.level === "core" }}>{s.name}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="brief__section" aria-labelledby="brief-experience">
      <h2 class="brief__h" id="brief-experience" data-reveal>{m.sectionExperience}</h2>
      {viewCv.experience.map((role) => (
        <article class="brief__role" data-reveal>
          <p class="brief__when">
            {formatDateRange(role.start, role.end, locale)} · {formatDuration(role.durationMonths, locale)}
            {formatRoleTitleParts(role, locale).concurrent && <> · {formatRoleTitleParts(role, locale).concurrent}</>}
          </p>
          <h3 class="brief__role-title">
            {formatRoleTitleParts(role, locale).title}
            <span class="brief__company">{role.company}</span>
            {role.clientDescription && <span class="brief__client">{role.clientDescription}</span>}
          </h3>
          <p class="brief__context">{role.context.short}</p>
          <ul class="brief__wins">
            {role.achievements.map((a) => (
              <li>
                {splitFigures(a.text.short).map((p) => (p.figure ? <strong class="brief__fig">{p.text}</strong> : p.text))}
                {a.metric && <span class="brief__metric-row"><span class="brief__metric">{formatMetricLabeled(a.metric, locale)}</span></span>}
              </li>
            ))}
          </ul>
          {stackOf(role).length > 0 && (
            <ul class="brief__stack" aria-label={m.sectionSkills}>
              {stackOf(role).map((name) => <li>{name}</li>)}
            </ul>
          )}
        </article>
      ))}
    </section>

    <section class="brief__section" id={anchors.projects} aria-labelledby="brief-projects">
      <h2 class="brief__h" id="brief-projects" data-reveal>{m.projectsTitle}</h2>
      <div class="brief__projects">
        {view.projects.map((p) => (
          <article class="brief__project" data-reveal>
            <h3>
              {p.name}
              {statusLabel[p.status] && <span class="brief__status">{statusLabel[p.status]}</span>}
            </h3>
            {p.client && <p class="brief__client">{p.client}</p>}
            <p>{p.solution.short}</p>
            <p class="brief__outcome">
              {splitFigures(p.outcome.short).map((part) => (part.figure ? <strong class="brief__fig">{part.text}</strong> : part.text))}
            </p>
            {p.links.length > 0 && (
              <p class="brief__links">
                {p.links.map((l) => <a href={l.url} rel="noopener">{l.label} <span aria-hidden="true">↗</span></a>)}
              </p>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="brief__section brief__section--pair" data-reveal>
      <div>
        <h2 class="brief__h">{m.sectionEducation}</h2>
        {viewCv.education.map((e) => (
          <div class="brief__edu">
            <p class="brief__edu-title">{e.degree}{e.field && <> — {e.field}</>}</p>
            <p class="brief__when">
              {e.institution}
              {e.end && <> · {e.start ? formatDateRange(e.start, e.end, locale) : formatYearMonth(e.end, locale)}</>}
              {e.status === "partial" && <> · {m.studyPartial}</>}
              {e.status === "in-progress" && <> · {m.studyInProgress}</>}
            </p>
          </div>
        ))}
      </div>
      <div>
        <h2 class="brief__h">{m.sectionLanguages}</h2>
        {viewCv.languages.map((l) => (
          <p class="brief__lang">
            <strong>{l.name}</strong> {l.level === "native" ? m.levelNative : l.level}
          </p>
        ))}
      </div>
    </section>
    {/* The same two actions at the end, where the reading stops. */}
    <footer class="brief__end" data-reveal>
      <div class="brief__actions">
        <button class="btn btn--solid" type="button" popovertarget="cv-pick">{m.downloadCv}</button>
        <a class="btn" href={LOCALE_PATHS[locale].home}>{t.guidedLink} <span aria-hidden="true">→</span></a>
      </div>
    </footer>
  </main>

  {/*
    The privacy line: Clarity records anonymous sessions, without cookies
    (src/scripts/analytics.ts). It lives here and not in `Base.astro` because
    the analytics do not live there either: if they are removed tomorrow,
    this line goes with them and is not left orphaned on `/cv`.

    Cloudflare Web Analytics is named separately because it records nothing
    and identifies nobody. Putting both in one sentence would suggest both
    record, and that would overstate in the direction that does not apply.
  */}
  <footer class="footer">
    <p>{m.footerPrivacyIntro}<a
        href="https://privacy.microsoft.com/privacystatement"
        rel="noopener noreferrer"
        target="_blank">{m.footerPrivacyLinkText}</a>{m.footerPrivacyOutro}</p>
  </footer>
</div>

<script>
  // Analytics first, in this same file and not a script of their own: Astro
  // inlines a small script, and the CSP (public/_headers) allows no inline
  // code but the landing's head script — Clarity would be blocked in
  // production. `Clarity.init` cannot throw; `start()` can, and must not take
  // the measurement with it.
  import { startAnalytics } from "../scripts/analytics";
  import { start } from "../scripts/brief/boot";
  startAnalytics();
  start();
</script>
