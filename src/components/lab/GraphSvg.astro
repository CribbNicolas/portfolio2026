---
/**
 * The map in SVG. NOT a placeholder while the 3D loads: it IS the map, with the
 * same coordinates the three.js scene uses. If the JS does not run — no JS,
 * `prefers-reduced-motion`, no WebGL, limited data — this is what is left, and
 * it is complete.
 *
 * Dumb component: it receives the draw list already computed by `buildSvgMap`
 * and writes attributes. It does not project, sort or filter.
 */
import type { SvgMap } from "../../lib/graph-svg";

interface Props {
  map: SvgMap;
  totalNodes: number;
  totalEdges: number;
}

const { map, totalNodes, totalEdges } = Astro.props;
---

<svg
  class="lab__svg"
  viewBox={map.viewBox}
  role="img"
  aria-label={`Mapa de conocimiento: ${totalNodes} nodos y ${totalEdges} conexiones entre roles, proyectos, logros y tecnologías.`}
>
  {map.edges.map((a) => (
    <line
      x1={a.x1} y1={a.y1} x2={a.x2} y2={a.y2}
      class={a.affinity ? "lab__arista lab__arista--afinidad" : "lab__arista"}
      style={`stroke-width:${a.width};opacity:${a.opacity}`}
    />
  ))}

  {map.nodes.map((n) => (
    <>
      {n.withEvidence && (
        <circle
          cx={n.cx} cy={n.cy} r={n.haloRadius}
          class="lab__halo"
          style={`opacity:${(n.opacity * 0.9).toFixed(3)}`}
        />
      )}
      <circle
        id={n.domId}
        cx={n.cx} cy={n.cy} r={n.r}
        class={`lab__nodo lab__nodo--${n.kind}${n.withEvidence ? "" : " lab__nodo--hueco"}`}
        style={`opacity:${n.withEvidence ? n.opacity : (n.opacity * 0.75).toFixed(3)};stroke-width:${n.strokeWidth}`}
      ><title>{n.label}</title></circle>
    </>
  ))}

  {map.labels.map((e) => (
    <text
      x={e.x}
      y={e.y}
      text-anchor="middle"
      class={`lab__etiqueta lab__etiqueta--${e.kind}`}
      style={`opacity:${e.opacity};font-size:${e.size}px`}
    >{e.text}</text>
  ))}
</svg>
