---
import type { Locale } from "@content";
import { MESSAGES } from "@content";
import { OG_HEIGHT, OG_WIDTH } from "../../scripts/og-template";

/** OG's own locale codes (BCP-ish, `xx_YY`) — a protocol detail, not chrome
 *  copy, so it lives here and not in `messages.ts`. */
const OG_LOCALE: Record<Locale, string> = { es: "es_AR", en: "en_US" };

/**
 * The set every `hreflang` page declares, INCLUDING itself — that
 * self-reference is part of the spec, not a redundant line: a crawler that
 * finds `/` announcing `/en/` as its alternate but not the other way around
 * treats the pair as unconfirmed and may ignore both.
 *
 * `x-default` points at the Spanish landing rather than at "whichever page
 * this is": the market this CV is written for is LatAm, so a crawler with no
 * better signal (no `Accept-Language`, a bot) should default to Spanish, not
 * to a guess. See docs/09 §2.3.
 */
const ALTERNATE_LOCALES: { hreflang: string; path: string }[] = [
  { hreflang: "es", path: "/" },
  { hreflang: "en", path: "/en/" },
  { hreflang: "x-default", path: "/" },
];

/**
 * Base layout. Its only responsibility is the `<head>`.
 *
 * The `head` slot exists so each page can inject its server-rendered JSON-LD:
 * crawlers do not execute JS, so it has to be in the server HTML
 * (docs/04 §3).
 */
interface Props {
  title: string;
  description: string;
  /**
   * `<html lang>` and, when `shareable`, `og:locale` and the OG/Twitter image
   * alt text. Defaults to `"es"` because every page predates the English ones
   * and none of them pass it explicitly yet outside `/en/*`. The OG image
   * itself (the JPEG `og:image` points at) stays the one committed artifact
   * for both locales — regenerating it per language is a separate slice, not
   * an oversight of this one.
   */
  locale?: Locale;
  /**
   * When `true`, the page emits Open Graph and a Twitter Card.
   *
   * Opt-in rather than a default with exceptions, on purpose. `/cv` carries
   * `noindex` and is not a shareable destination — it exists so Browser
   * Rendering can print the PDF — and neither is the 404. With a `true` default
   * you would have to remember to switch it off on every new page; this way,
   * forgetting means emitting no tags, which is the safe side of the mistake.
   */
  shareable?: boolean;
  /**
   * When `true`, the page emits `hreflang` alternates for the two indexable
   * landings (`ALTERNATE_LOCALES` above).
   *
   * Opt-in for the same reason as `shareable`: `/cv` and `/en/cv` carry
   * `noindex`, and `hreflang` on a page asking not to be indexed is a
   * contradiction crawlers report as an error, not a courtesy they ignore.
   * Forgetting to pass this on a new page means emitting nothing, which is
   * the safe side of the mistake.
   */
  hreflang?: boolean;
}

const { title, description, locale = "es", shareable = false, hreflang = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const m = MESSAGES[locale];

// The dimensions come from the same module that uses them to generate the
// JPEG: if the card ever changes size, the tags follow on their own instead of
// lying to LinkedIn about the space it has to reserve.
const socialImage = new URL("/og.jpg", Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      hreflang && ALTERNATE_LOCALES.map(({ hreflang: lang, path }) => (
        <link rel="alternate" hreflang={lang} href={new URL(path, Astro.site)} />
      ))
    }

    {/*
      SVG and not `.ico`: under 1 KB, scales to any size and responds to dark
      mode from the inside. Every current browser supports it; very old ones —
      Safari before 15 — show none at all, which is exactly what happened up to
      now.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/*
      The iOS home screen icon. It exists separately because Safari does NOT
      accept SVG here: it has to be a bitmap. Without this file, saving the site
      to the home screen gives a shrunken screenshot of the page instead of an
      icon. `pnpm run og:local` generates it alongside the social card.

      One size only: since iOS 8, 180×180 is enough and the system derives the
      rest.
    */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/*
      Tints the browser chrome on Android and the status bar on iOS. Two tags
      and not one because the site has a dark mode: with a single value the bar
      ends up light over a dark page, or the other way around.

      The values are the `--bg` token from `tokens.css` in each mode. This is
      the second — and last — copy of a color outside that file: no `var()`
      works here, because what reads this is the operating system and not the
      cascade.
    */}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131417" media="(prefers-color-scheme: dark)" />

    {
      shareable && (
        <Fragment>
          {/*
            Open Graph. Without this, pasting the link into LinkedIn or
            WhatsApp shows a bare URL — and pasting the link IS the channel a
            portfolio is distributed through.
          */}
          <meta property="og:type" content="profile" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical.toString()} />
          <meta property="og:locale" content={OG_LOCALE[locale]} />

          {/*
            The image. ONE for every network: Facebook, LinkedIn, WhatsApp,
            Slack, Discord and Twitter all read the same `og:image`, and what
            differs between them is how they crop it, not which file they ask
            for.

            Absolute and not relative: no scraper resolves relative paths, and
            an `og:image` that cannot be fetched is the same as having none.

            `width`/`height` because LinkedIn and Slack reserve the space with
            those two before downloading the image; without them the card jumps
            size once it finishes loading.

            The file is generated by `pnpm run og:local` and is COMMITTED — it
            does not come out of the build, because rasterizing needs Chromium
            and the Cloudflare builder does not have it. `og-output.check.ts`
            verifies it has not gone stale against the dataset.
          */}
          <meta property="og:image" content={socialImage.toString()} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={String(OG_WIDTH)} />
          <meta property="og:image:height" content={String(OG_HEIGHT)} />
          <meta property="og:image:alt" content={`${title}. ${m.ogImageAltSuffix}`} />

          {/*
            `summary_large_image` and not `summary`: the small one reserves a
            square beside the text and would crop a 1.91:1 card into a little
            square. It was on `summary` while there was no image.
          */}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={socialImage.toString()} />
          <meta name="twitter:image:alt" content={`${title}. ${m.ogImageAltSuffix}`} />
        </Fragment>
      )
    }

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
