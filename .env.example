# Template. Copy to `.env` and fill in. `.env` is in .gitignore: it is NEVER
# committed. See docs/05-deploy-and-analytics.md §3 for where each value goes.
#
# NOTE: the deploy no longer uses a Cloudflare token from GitHub Actions. Pages
# builds the repo itself (Git integration), so there is no deploy secret to
# rotate. The only thing left with real permissions is the Browser Rendering
# token, and it lives in the Pages project config, not here.

# Public URL of the site. Without it, the JSON-LD and the canonical point at
# https://portfolio.invalid, which breaks on purpose (astro.config.mjs).
SITE_URL=https://tudominio.com

# Microsoft Clarity. Not a secret — it travels in the HTML of every visit — but
# it is read from here so changing project does not touch code.
PUBLIC_CLARITY_ID=

# Cloudflare Web Analytics. Not a secret either — the beacon carries it in the
# HTML — but it is read from here for the same reason as Clarity's: to rotate it
# or switch the measurement off without touching code.
#
# CAREFUL: do NOT enable Web Analytics from the Pages dashboard. That injects the
# snippet into the WHOLE site, /cv included, and the PDF is printed from there.
# Manual setup only.
PUBLIC_CF_BEACON_TOKEN=
