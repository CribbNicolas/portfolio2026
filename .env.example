# Plantilla. Copiar a `.env` y completar. `.env` está en .gitignore: NUNCA
# se commitea. Los mismos valores van como secrets de GitHub para que el
# workflow pueda deployar — ver docs/05-deploy-y-analitica.md §2.

# URL pública del sitio. Sin esto, el JSON-LD y el canonical salen apuntando a
# https://portfolio.invalid, que revienta a propósito (astro.config.mjs).
SITE_URL=https://tudominio.com

# Cloudflare. El token necesita UN permiso: Account → Cloudflare Pages → Edit.
# Da escritura sobre los deploys de la cuenta: si se filtra, revocalo y generá
# otro en vez de intentar limpiar el historial.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=

# Microsoft Clarity. No es secreto —viaja en el HTML de cada visita— pero se
# lee de acá para no tocar código si cambia de proyecto.
PUBLIC_CLARITY_ID=
