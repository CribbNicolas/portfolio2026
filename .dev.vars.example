# Template of the variables `functions/cv.pdf.ts` sees when it runs locally with
# `pnpm exec wrangler pages dev dist`. Copy to `.dev.vars`, which is in
# .gitignore.
#
# In production these SAME names are configured in the Cloudflare Pages dashboard
# (Settings → Variables and Secrets), not in a file. See
# docs/05-deploy-and-analytics.md §3.
#
# They are not needed to work on the CV: `pnpm run dev` serves `/cv` in HTML and
# `pnpm run pdf:local` prints the PDF with Playwright, neither touching the
# cloud. This is only for testing the Function.

# Dashboard → Workers & Pages → right-hand panel. Not a secret.
BROWSER_RENDERING_ACCOUNT_ID=

# A token with ONE permission: Developer Platform → Browser Run → Edit. Nothing
# else. (Browser Run is the new name for Browser Rendering; the API path did not
# change.) If it shows up in a log or a commit: revoke it and generate another.
# Rotating it takes two minutes, cleaning the git history does not.
BROWSER_RENDERING_TOKEN=

# Optional. The name the file is saved under by whoever downloads it. Default: cv.pdf
PDF_FILENAME=
